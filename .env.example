# Copy this file to ".env" and add your real key.
# The Anthropic API key is read ONLY by the backend (server.js).
# It is never sent to the browser.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides -------------------------------------------------------
# The model used for generating questions and validating answers.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Port the local server listens on (default 3000).
PORT=3000
