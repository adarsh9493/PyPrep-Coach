# PyPrep Coach - environment configuration
# Copy this file to ".env" and fill in a free provider below.
# This key is read ONLY by the backend (server.js) and is never sent to the browser.

# --------------------------------------------------------------------------
# FREE MODEL PROVIDER
# Pick one of: gemini | groq | openrouter | ollama
#   gemini      - Google Gemini free tier (RECOMMENDED: easy key, great at JSON)
#   groq        - Groq free tier (very fast Llama 3.3 70B)
#   openrouter  - OpenRouter free models (many options, rate-limited)
#   ollama      - fully local, no key needed (install Ollama + pull a model)
# --------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Your API key for the chosen provider.
#   Gemini  -> https://aistudio.google.com/apikey   (free, no card)
#   Groq    -> https://console.groq.com/keys        (free)
#   OpenRouter -> https://openrouter.ai/keys        (free models)
#   Ollama  -> leave empty (no key required)
LLM_API_KEY=your-free-api-key-here

# --------------------------------------------------------------------------
# OPTIONAL OVERRIDES
# Sensible defaults are chosen per provider; only set these to change them.
# --------------------------------------------------------------------------

# Override the model (e.g. gemini-2.5-flash, llama-3.1-8b-instant).
#LLM_MODEL=gemini-flash-latest

# Override the API base URL (for a self-hosted OpenAI-compatible server).
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Port the local server listens on (default 3000).
#PORT=3000
